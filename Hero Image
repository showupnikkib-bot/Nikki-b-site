.hero-image {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero-image img {
  width: 100%;
  height: auto;
  display: block;
}

/* 👇 THIS CREATES YOUR WHITE VIGNETTE FADE */
.hero-image::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 35%; /* adjust if needed */
  background: linear-gradient(
    to top,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.85) 30%,
    rgba(255, 255, 255, 0) 100%
  );
  pointer-events: none;
